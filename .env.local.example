# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# BimpeAI (required) — server-side only, never exposed to the browser
BIMPEAI_API_KEY=sk_xxx

# Demo customer (the controllable test endpoints confirmations actually deliver to)
DEMO_CUSTOMER_EMAIL=you@example.com
DEMO_CUSTOMER_WHATSAPP=+447700900123

# Feature flags (auto-detected at runtime; override to force a mode)
# STRIPE_MODE=stripe|simulated
# EMAIL_LIVE=true|false
# WHATSAPP_MODE=api|agent-turn
# FALLBACK_VIDEO=false

# On-stage software fallback (deterministic golden-path replay; default OFF).
# When DEMO_MODE=replay, POST /api/demo/replay emits the canned golden-path
# events on a timer with NO live BimpeAI/Stripe/Gmail/WhatsApp call and NO
# network — the dashboard lights up identically. Leave unset for live runs.
# DEMO_MODE=replay

# Webhook signing secret (set if BimpeAI webhooks are wired)
# BIMPE_WEBHOOK_SECRET=whsec_xxx

# BimpeAI's INBOUND Stripe webhook for OUR agent (Stripe -> BimpeAI).
# Add this URL as a webhook endpoint in your Stripe dashboard (test mode) so
# Stripe refund/charge events flow to the BimpeAI agent — enabling a
# BimpeAI-native refund path (alternative to our-app refund execution).
# Not a secret (contains only the agent id). Agent = "Refund Concierge — demo".
# BIMPE_STRIPE_WEBHOOK_URL=https://api.bimpe.ai/webhook/agent/cmqtuq8xu010fpc6ekpx596ux/stripe
